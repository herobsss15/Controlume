POSTGRES_DB=controlume
POSTGRES_USER=controlume
POSTGRES_PASSWORD=troque-por-uma-senha-local

# Usado pelo serviço "web" (docker-compose.yml). Em produção, deixe Production.
ASPNETCORE_ENVIRONMENT=Production

# Usuários do sistema. Não existe tela de cadastro de usuário: eles são criados (e têm a
# senha atualizada) no startup a partir daqui. Para resetar uma senha, troque o valor e rode
# `docker compose up -d --build` de novo.
#
# Admin: acessa tudo, incluindo cadastro de produtos e tipos de produto.
ADMIN_NOME=Administrador
ADMIN_LOGIN=admin
ADMIN_SENHA=troque-por-uma-senha-forte

# Operador: venda, caixa, sangria e históricos — sem os cadastros. Opcional: deixe a senha
# em branco para não criar o usuário.
OPERADOR_NOME=Operador
OPERADOR_LOGIN=operador
OPERADOR_SENHA=

# Stakeholder: vê todas as telas, mas não executa nenhuma ação. Também opcional.
STAKEHOLDER_NOME=Stakeholder
STAKEHOLDER_LOGIN=stakeholder
STAKEHOLDER_SENHA=
