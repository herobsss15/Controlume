POSTGRES_DB=controlume
POSTGRES_USER=controlume
POSTGRES_PASSWORD=troque-por-uma-senha-local

# Usado pelo serviço "web" (docker-compose.yml). Em produção, deixe Production.
ASPNETCORE_ENVIRONMENT=Production

# Admin de bootstrap: é com ele que você entra pela primeira vez para criar os demais
# usuários na tela /usuarios. Operador e Stakeholder não se configuram aqui — são criados
# por lá. Se a senha do Admin se perder, troque ADMIN_SENHA e suba de novo: o hash é
# regravado no startup.
ADMIN_NOME=Administrador
ADMIN_LOGIN=admin
ADMIN_SENHA=troque-por-uma-senha-forte
