@page "/produtos"
@inject ProdutoService ProdutoService
@inject TipoProdutoService TipoProdutoService

<PageTitle>Produtos</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Produtos</h1>
    <a class="btn btn-primary" href="produtos/novo">Novo produto</a>
</div>

<div class="row g-3 mb-3">
    <div class="col-auto">
        <label class="form-label" for="filtro-tipo">Tipo</label>
        <select id="filtro-tipo" class="form-select" @bind="filtroTipoProdutoId" @bind:after="CarregarAsync">
            <option value="">Todos</option>
            @if (tipos is not null)
            {
                @foreach (var tipo in tipos)
                {
                    <option value="@tipo.Id">@tipo.Nome</option>
                }
            }
        </select>
    </div>
    <div class="col-auto d-flex align-items-end">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="mostrar-inativos" @bind="mostrarInativos" @bind:after="CarregarAsync" />
            <label class="form-check-label" for="mostrar-inativos">Mostrar inativos</label>
        </div>
    </div>
</div>

@if (produtos is null)
{
    <p>Carregando...</p>
}
else if (produtos.Count == 0)
{
    <p class="text-muted">Nenhum produto encontrado.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Tipo</th>
                <th>Artista/Grupo</th>
                <th class="text-end">Preço</th>
                <th class="text-end">Estoque</th>
                <th>Status</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var produto in produtos)
            {
                <tr>
                    <td>@produto.Nome</td>
                    <td>@produto.TipoProduto?.Nome</td>
                    <td>@(produto.ArtistaGrupo ?? "—")</td>
                    <td class="text-end">@produto.Preco.ToString("C")</td>
                    <td class="text-end">@produto.QuantidadeEstoque</td>
                    <td>
                        @if (produto.Ativo)
                        {
                            <span class="badge text-bg-success">Ativo</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Inativo</span>
                        }
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary me-1" href="@($"produtos/{produto.Id}/editar")">Editar</a>
                        @if (produto.Ativo)
                        {
                            <button class="btn btn-sm btn-outline-warning" @onclick="() => DesativarAsync(produto.Id)">Desativar</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-success" @onclick="() => ReativarAsync(produto.Id)">Reativar</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Produto>? produtos;
    private List<TipoProduto>? tipos;
    private bool mostrarInativos;
    private string filtroTipoProdutoId = "";

    protected override async Task OnInitializedAsync()
    {
        tipos = await TipoProdutoService.ListarAsync(incluirInativos: true);
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        int? tipoId = int.TryParse(filtroTipoProdutoId, out var id) ? id : null;
        produtos = await ProdutoService.ListarAsync(incluirInativos: mostrarInativos, tipoProdutoId: tipoId);
    }

    private async Task DesativarAsync(int id)
    {
        await ProdutoService.DesativarAsync(id);
        await CarregarAsync();
    }

    private async Task ReativarAsync(int id)
    {
        await ProdutoService.ReativarAsync(id);
        await CarregarAsync();
    }
}
