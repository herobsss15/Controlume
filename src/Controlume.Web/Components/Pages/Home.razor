@page "/"
@inject CaixaService CaixaService

<PageTitle>Controlume</PageTitle>

<h1>Controlume</h1>
<p class="text-muted">PDV para loja de discos.</p>

@if (carregando)
{
    <p>Carregando...</p>
}
else if (caixaAberto is null)
{
    <div class="alert alert-warning d-flex justify-content-between align-items-center">
        <span>Nenhum caixa aberto no momento.</span>
        <a class="btn btn-primary btn-sm" href="caixa">Abrir caixa</a>
    </div>
}
else
{
    <div class="alert alert-success d-flex justify-content-between align-items-center">
        <span>Caixa aberto desde @caixaAberto.DataAbertura.ToLocalTime().ToString("g").</span>
        <a class="btn btn-primary btn-sm" href="venda">Nova venda</a>
    </div>
}

<div class="row g-3 mt-2">
    <div class="col-md-4">
        <a class="btn btn-outline-primary w-100" href="venda">Nova venda</a>
    </div>
    <div class="col-md-4">
        <a class="btn btn-outline-primary w-100" href="produtos">Produtos</a>
    </div>
    <div class="col-md-4">
        <a class="btn btn-outline-primary w-100" href="tipos-produto">Tipos de Produto</a>
    </div>
    <div class="col-md-4">
        <a class="btn btn-outline-secondary w-100" href="caixa">Caixa</a>
    </div>
    <div class="col-md-4">
        <a class="btn btn-outline-secondary w-100" href="vendas/historico">Histórico de Vendas</a>
    </div>
    <div class="col-md-4">
        <a class="btn btn-outline-secondary w-100" href="caixa/historico">Histórico de Caixa</a>
    </div>
</div>

@code {
    private FechamentoCaixa? caixaAberto;
    private bool carregando = true;

    protected override async Task OnInitializedAsync()
    {
        caixaAberto = await CaixaService.ObterAbertoAsync();
        carregando = false;
    }
}
