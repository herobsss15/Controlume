<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">Controlume</a>
        <AuthorizeView>
            <Authorized>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-label="Alternar navegação">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><NavLink class="nav-link" href="venda">Venda</NavLink></li>
                        <li class="nav-item"><NavLink class="nav-link" href="caixa" Match="NavLinkMatch.All">Caixa</NavLink></li>
                        <li class="nav-item"><NavLink class="nav-link" href="produtos">Produtos</NavLink></li>
                        @* Regra 17: cadastro de tipos é tela de Admin; o Stakeholder entra só para olhar. *@
                        <AuthorizeView Roles="Admin,Stakeholder" Context="cadastros">
                            <li class="nav-item"><NavLink class="nav-link" href="tipos-produto">Tipos de Produto</NavLink></li>
                            <li class="nav-item"><NavLink class="nav-link" href="formas-pagamento">Formas de Pagamento</NavLink></li>
                        </AuthorizeView>
                        <li class="nav-item"><NavLink class="nav-link" href="vendas/historico">Histórico de Vendas</NavLink></li>
                        <li class="nav-item"><NavLink class="nav-link" href="caixa/historico">Histórico de Caixa</NavLink></li>
                        <AuthorizeView Roles="Admin" Context="usuarios">
                            <li class="nav-item"><NavLink class="nav-link" href="usuarios">Usuários</NavLink></li>
                        </AuthorizeView>
                    </ul>
                    <span class="navbar-text me-3">@context.User.Identity?.Name (@PapelExibicao(context.User))</span>
                    <a class="btn btn-sm btn-outline-light" href="logout">Sair</a>
                </div>
            </Authorized>
        </AuthorizeView>
    </div>
</nav>

@code {
    private static string PapelExibicao(System.Security.Claims.ClaimsPrincipal user)
        => user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "sem papel";
}
